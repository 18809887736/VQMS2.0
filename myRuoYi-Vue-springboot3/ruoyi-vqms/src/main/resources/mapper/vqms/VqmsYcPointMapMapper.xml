<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.vqms.mapper.VqmsYcPointMapMapper">
    
    <resultMap type="VqmsYcPointMap" id="VqmsYcPointMapResult">
        <result property="pointNum"    column="point_num"    />
        <result property="pointKey"    column="point_key"    />
        <result property="pointKind"    column="point_kind"    />
        <result property="pointName"    column="point_name"    />
        <result property="pointType"    column="point_type"    />
        <result property="entityId"    column="entity_id"    />
        <result property="busbarNum"    column="busbar_num"    />
        <result property="unit"    column="unit"    />
        <result property="state1Label"    column="state_1_label"    />
        <result property="state0Label"    column="state_0_label"    />
        <result property="gateEnabled"    column="gate_enabled"    />
        <result property="status"    column="status"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectVqmsYcPointMapVo">
        select point_num, point_key, point_kind, point_name, point_type, entity_id, busbar_num, unit, state_1_label, state_0_label, gate_enabled, status, create_time, update_time, remark from vqms_yc_point_map
    </sql>

    <select id="selectVqmsYcPointMapList" parameterType="VqmsYcPointMap" resultMap="VqmsYcPointMapResult">
        <include refid="selectVqmsYcPointMapVo"/>
        <where>
            <if test="pointKey != null  and pointKey != ''"> and point_key = #{pointKey}</if>
            <if test="pointKind != null  and pointKind != ''"> and point_kind = #{pointKind}</if>
            <if test="pointName != null  and pointName != ''"> and point_name like concat('%', #{pointName}, '%')</if>
            <if test="pointType != null  and pointType != ''"> and point_type = #{pointType}</if>
            <if test="entityId != null "> and entity_id = #{entityId}</if>
            <if test="busbarNum != null "> and busbar_num = #{busbarNum}</if>
            <if test="unit != null  and unit != ''"> and unit = #{unit}</if>
            <if test="state1Label != null  and state1Label != ''"> and state_1_label = #{state1Label}</if>
            <if test="state0Label != null  and state0Label != ''"> and state_0_label = #{state0Label}</if>
            <if test="gateEnabled != null "> and gate_enabled = #{gateEnabled}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectVqmsYcPointMapByPointNum" parameterType="Long" resultMap="VqmsYcPointMapResult">
        <include refid="selectVqmsYcPointMapVo"/>
        where point_num = #{pointNum}
    </select>

    <insert id="insertVqmsYcPointMap" parameterType="VqmsYcPointMap">
        insert into vqms_yc_point_map
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="pointNum != null">point_num,</if>
            <if test="pointKey != null and pointKey != ''">point_key,</if>
            <if test="pointKind != null and pointKind != ''">point_kind,</if>
            <if test="pointName != null and pointName != ''">point_name,</if>
            <if test="pointType != null">point_type,</if>
            <if test="entityId != null">entity_id,</if>
            <if test="busbarNum != null">busbar_num,</if>
            <if test="unit != null">unit,</if>
            <if test="state1Label != null">state_1_label,</if>
            <if test="state0Label != null">state_0_label,</if>
            <if test="gateEnabled != null">gate_enabled,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="pointNum != null">#{pointNum},</if>
            <if test="pointKey != null and pointKey != ''">#{pointKey},</if>
            <if test="pointKind != null and pointKind != ''">#{pointKind},</if>
            <if test="pointName != null and pointName != ''">#{pointName},</if>
            <if test="pointType != null">#{pointType},</if>
            <if test="entityId != null">#{entityId},</if>
            <if test="busbarNum != null">#{busbarNum},</if>
            <if test="unit != null">#{unit},</if>
            <if test="state1Label != null">#{state1Label},</if>
            <if test="state0Label != null">#{state0Label},</if>
            <if test="gateEnabled != null">#{gateEnabled},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateVqmsYcPointMap" parameterType="VqmsYcPointMap">
        update vqms_yc_point_map
        <trim prefix="SET" suffixOverrides=",">
            <if test="pointKey != null and pointKey != ''">point_key = #{pointKey},</if>
            <if test="pointKind != null and pointKind != ''">point_kind = #{pointKind},</if>
            <if test="pointName != null and pointName != ''">point_name = #{pointName},</if>
            <if test="pointType != null">point_type = #{pointType},</if>
            <if test="entityId != null">entity_id = #{entityId},</if>
            <if test="busbarNum != null">busbar_num = #{busbarNum},</if>
            <if test="unit != null">unit = #{unit},</if>
            <if test="state1Label != null">state_1_label = #{state1Label},</if>
            <if test="state0Label != null">state_0_label = #{state0Label},</if>
            <if test="gateEnabled != null">gate_enabled = #{gateEnabled},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where point_num = #{pointNum}
    </update>

    <delete id="deleteVqmsYcPointMapByPointNum" parameterType="Long">
        delete from vqms_yc_point_map where point_num = #{pointNum}
    </delete>

    <delete id="deleteVqmsYcPointMapByPointNums" parameterType="String">
        delete from vqms_yc_point_map where point_num in 
        <foreach item="pointNum" collection="array" open="(" separator="," close=")">
            #{pointNum}
        </foreach>
    </delete>
</mapper>