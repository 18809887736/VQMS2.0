<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.vqms.mapper.VqmsEntityMapper">

    <resultMap type="VqmsEntity" id="VqmsEntityResult">
        <id     property="entityId"         column="entity_id"/>
        <result property="entityCode"       column="entity_code"/>
        <result property="entityName"       column="entity_name"/>
        <result property="entityType"       column="entity_type"/>
        <result property="ratedCapacityKw"  column="rated_capacity_kw"/>
        <result property="avcClosedLoop"    column="avc_closed_loop"/>
        <result property="effectiveFrom"    column="effective_from"/>
        <result property="effectiveTo"      column="effective_to"/>
        <result property="status"           column="status"/>
        <result property="createBy"         column="create_by"/>
        <result property="createTime"       column="create_time"/>
        <result property="updateBy"         column="update_by"/>
        <result property="updateTime"       column="update_time"/>
        <result property="remark"           column="remark"/>
    </resultMap>

    <sql id="selectVqmsEntityVo">
        select entity_id, entity_code, entity_name, entity_type, rated_capacity_kw, avc_closed_loop,
               effective_from, effective_to, status, create_by, create_time, update_by, update_time, remark
        from vqms_entity
    </sql>

    <select id="selectVqmsEntityList" parameterType="VqmsEntity" resultMap="VqmsEntityResult">
        <include refid="selectVqmsEntityVo"/>
        <where>
            <if test="entityCode != null  and entityCode != ''"> and entity_code = #{entityCode}</if>
            <if test="entityName != null  and entityName != ''"> and entity_name like concat('%', #{entityName}, '%')</if>
            <if test="entityType != null  and entityType != ''"> and entity_type = #{entityType}</if>
            <if test="avcClosedLoop != null "> and avc_closed_loop = #{avcClosedLoop}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
        order by entity_id
    </select>

    <select id="selectVqmsEntityById" parameterType="Long" resultMap="VqmsEntityResult">
        <include refid="selectVqmsEntityVo"/>
        where entity_id = #{entityId}
    </select>

    <insert id="insertVqmsEntity" parameterType="VqmsEntity" useGeneratedKeys="true" keyProperty="entityId">
        insert into vqms_entity (
            entity_code, entity_name, entity_type, rated_capacity_kw, avc_closed_loop,
            effective_from, effective_to, status, create_by, create_time, remark
        ) values (
            #{entityCode}, #{entityName}, #{entityType}, #{ratedCapacityKw}, #{avcClosedLoop},
            #{effectiveFrom}, #{effectiveTo}, #{status}, #{createBy}, sysdate(), #{remark}
        )
    </insert>

    <update id="updateVqmsEntity" parameterType="VqmsEntity">
        update vqms_entity
        <trim prefix="SET" suffixOverrides=",">
            <if test="entityCode != null and entityCode != ''">entity_code = #{entityCode},</if>
            <if test="entityName != null and entityName != ''">entity_name = #{entityName},</if>
            <if test="entityType != null and entityType != ''">entity_type = #{entityType},</if>
            rated_capacity_kw = #{ratedCapacityKw},
            avc_closed_loop = #{avcClosedLoop},
            effective_from = #{effectiveFrom},
            effective_to = #{effectiveTo},
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate(),
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where entity_id = #{entityId}
    </update>

    <delete id="deleteVqmsEntityById" parameterType="Long">
        delete from vqms_entity where entity_id = #{entityId}
    </delete>

    <delete id="deleteVqmsEntityByIds" parameterType="String">
        delete from vqms_entity where entity_id in
        <foreach item="entityId" collection="array" open="(" separator="," close=")">
            #{entityId}
        </foreach>
    </delete>
</mapper>
