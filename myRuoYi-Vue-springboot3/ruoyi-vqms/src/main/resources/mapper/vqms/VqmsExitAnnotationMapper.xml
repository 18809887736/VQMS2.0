<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.vqms.mapper.VqmsExitAnnotationMapper">
    
    <resultMap type="VqmsExitAnnotation" id="VqmsExitAnnotationResult">
        <result property="annotationId"    column="annotation_id"    />
        <result property="entityId"    column="entity_id"    />
        <result property="periodStart"    column="period_start"    />
        <result property="periodEnd"    column="period_end"    />
        <result property="exitReason"    column="exit_reason"    />
        <result property="source"    column="source"    />
        <result property="evidence"    column="evidence"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectVqmsExitAnnotationVo">
        select annotation_id, entity_id, period_start, period_end, exit_reason, source, evidence, status, create_by, create_time, update_by, update_time, remark from vqms_exit_annotation
    </sql>

    <select id="selectVqmsExitAnnotationList" parameterType="VqmsExitAnnotation" resultMap="VqmsExitAnnotationResult">
        <include refid="selectVqmsExitAnnotationVo"/>
        <where>  
            <if test="entityId != null "> and entity_id = #{entityId}</if>
            <if test="periodStart != null "> and period_start = #{periodStart}</if>
            <if test="periodEnd != null "> and period_end = #{periodEnd}</if>
            <if test="exitReason != null  and exitReason != ''"> and exit_reason = #{exitReason}</if>
            <if test="source != null  and source != ''"> and source = #{source}</if>
            <if test="evidence != null  and evidence != ''"> and evidence = #{evidence}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectVqmsExitAnnotationByAnnotationId" parameterType="Long" resultMap="VqmsExitAnnotationResult">
        <include refid="selectVqmsExitAnnotationVo"/>
        where annotation_id = #{annotationId}
    </select>

    <insert id="insertVqmsExitAnnotation" parameterType="VqmsExitAnnotation" useGeneratedKeys="true" keyProperty="annotationId">
        insert into vqms_exit_annotation
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="entityId != null">entity_id,</if>
            <if test="periodStart != null">period_start,</if>
            <if test="periodEnd != null">period_end,</if>
            <if test="exitReason != null and exitReason != ''">exit_reason,</if>
            <if test="source != null and source != ''">source,</if>
            <if test="evidence != null">evidence,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="entityId != null">#{entityId},</if>
            <if test="periodStart != null">#{periodStart},</if>
            <if test="periodEnd != null">#{periodEnd},</if>
            <if test="exitReason != null and exitReason != ''">#{exitReason},</if>
            <if test="source != null and source != ''">#{source},</if>
            <if test="evidence != null">#{evidence},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateVqmsExitAnnotation" parameterType="VqmsExitAnnotation">
        update vqms_exit_annotation
        <trim prefix="SET" suffixOverrides=",">
            <if test="entityId != null">entity_id = #{entityId},</if>
            <if test="periodStart != null">period_start = #{periodStart},</if>
            <if test="periodEnd != null">period_end = #{periodEnd},</if>
            <if test="exitReason != null and exitReason != ''">exit_reason = #{exitReason},</if>
            <if test="source != null and source != ''">source = #{source},</if>
            <if test="evidence != null">evidence = #{evidence},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where annotation_id = #{annotationId}
    </update>

    <delete id="deleteVqmsExitAnnotationByAnnotationId" parameterType="Long">
        delete from vqms_exit_annotation where annotation_id = #{annotationId}
    </delete>

    <delete id="deleteVqmsExitAnnotationByAnnotationIds" parameterType="String">
        delete from vqms_exit_annotation where annotation_id in 
        <foreach item="annotationId" collection="array" open="(" separator="," close=")">
            #{annotationId}
        </foreach>
    </delete>
</mapper>