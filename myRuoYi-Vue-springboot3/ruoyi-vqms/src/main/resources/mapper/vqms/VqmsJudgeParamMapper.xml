<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.vqms.mapper.VqmsJudgeParamMapper">
    
    <resultMap type="VqmsJudgeParam" id="VqmsJudgeParamResult">
        <result property="paramId"    column="param_id"    />
        <result property="paramKey"    column="param_key"    />
        <result property="paramValue"    column="param_value"    />
        <result property="name"    column="name"    />
        <result property="description"    column="description"    />
        <result property="valueMin"    column="value_min"    />
        <result property="valueMax"    column="value_max"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectVqmsJudgeParamVo">
        select param_id, param_key, param_value, name, description, value_min, value_max, status, create_by, create_time, update_by, update_time, remark from vqms_judge_param
    </sql>

    <select id="selectVqmsJudgeParamList" parameterType="VqmsJudgeParam" resultMap="VqmsJudgeParamResult">
        <include refid="selectVqmsJudgeParamVo"/>
        <where>  
            <if test="paramKey != null  and paramKey != ''"> and param_key = #{paramKey}</if>
            <if test="paramValue != null "> and param_value = #{paramValue}</if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="description != null  and description != ''"> and description = #{description}</if>
            <if test="valueMin != null "> and value_min = #{valueMin}</if>
            <if test="valueMax != null "> and value_max = #{valueMax}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectVqmsJudgeParamByParamId" parameterType="Long" resultMap="VqmsJudgeParamResult">
        <include refid="selectVqmsJudgeParamVo"/>
        where param_id = #{paramId}
    </select>

    <insert id="insertVqmsJudgeParam" parameterType="VqmsJudgeParam" useGeneratedKeys="true" keyProperty="paramId">
        insert into vqms_judge_param
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="paramKey != null and paramKey != ''">param_key,</if>
            <if test="paramValue != null">param_value,</if>
            <if test="name != null and name != ''">name,</if>
            <if test="description != null">description,</if>
            <if test="valueMin != null">value_min,</if>
            <if test="valueMax != null">value_max,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="paramKey != null and paramKey != ''">#{paramKey},</if>
            <if test="paramValue != null">#{paramValue},</if>
            <if test="name != null and name != ''">#{name},</if>
            <if test="description != null">#{description},</if>
            <if test="valueMin != null">#{valueMin},</if>
            <if test="valueMax != null">#{valueMax},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateVqmsJudgeParam" parameterType="VqmsJudgeParam">
        update vqms_judge_param
        <trim prefix="SET" suffixOverrides=",">
            <if test="paramKey != null and paramKey != ''">param_key = #{paramKey},</if>
            <if test="paramValue != null">param_value = #{paramValue},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="description != null">description = #{description},</if>
            <if test="valueMin != null">value_min = #{valueMin},</if>
            <if test="valueMax != null">value_max = #{valueMax},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where param_id = #{paramId}
    </update>

    <delete id="deleteVqmsJudgeParamByParamId" parameterType="Long">
        delete from vqms_judge_param where param_id = #{paramId}
    </delete>

    <delete id="deleteVqmsJudgeParamByParamIds" parameterType="String">
        delete from vqms_judge_param where param_id in 
        <foreach item="paramId" collection="array" open="(" separator="," close=")">
            #{paramId}
        </foreach>
    </delete>
</mapper>